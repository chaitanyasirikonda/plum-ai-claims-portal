# Plum AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Groq API (LLM backend)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for document extraction / OCR reasoning
# Available options: llama-3.3-70b-versatile | llama-3.1-8b-instant | meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=llama-3.3-70b-versatile

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
